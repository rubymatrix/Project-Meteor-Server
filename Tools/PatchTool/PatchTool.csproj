<Project Sdk="Microsoft.NET.Sdk">
  <!-- Signing for retail patch downloads: makes the key and certificate ffxivboot checks torrent
       signatures against, signs torrents, and writes an ffxivboot.exe copy that trusts the
       certificate. From the repository root: dotnet run with the project Tools/PatchTool. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Meteor.Tools.PatchTool</RootNamespace>
    <AssemblyName>PatchTool</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- One copy of the signature format, shared with the Web Server that signs at startup. -->
    <Compile Include="..\..\Web Server\Patching\PatchSignature.cs" Link="PatchSignature.cs" />
  </ItemGroup>
</Project>
