<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Meteor.Map</RootNamespace>
    <AssemblyName>Map Server</AssemblyName>
    <MeteorIni>map_config.ini</MeteorIni>
  </PropertyGroup>

  <ItemGroup>
    <!-- Legacy/unfinished files that were never part of the old project's compile list. -->
    <Compile Remove="DataObjects\database\DBWorld.cs" />
    <Compile Remove="Packets\Send\Actor\Battle\BattleAction.cs" />
    <Compile Remove="Packets\Send\Actor\Battle\BattleActionX10Packet.cs" />
    <Compile Remove="Packets\Send\Actor\Battle\BattleActionX18Packet.cs" />
    <Compile Remove="Packets\Send\Actor\Inventory\SetInitialEquipmentPacket.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common Class Lib\Common Class Lib.csproj" />
    <ProjectReference Include="..\ThirdParty\XLua\XLua.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MoonSharp" Version="2.0.0" />
    <PackageReference Include="MySql.Data" Version="$(MySqlDataVersion)" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NLog" Version="6.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SharpNav">
      <HintPath>navmesh\SharpNav.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="NLog.config" CopyToOutputDirectory="PreserveNewest" />
    <!-- Runtime data the map server reads from its working directory. -->
    <None Include="..\Data\scripts\**\*" Link="scripts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Data\staticactors.bin" Link="staticactors.bin" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\Data\staticactors.bin')" />
  </ItemGroup>
</Project>
