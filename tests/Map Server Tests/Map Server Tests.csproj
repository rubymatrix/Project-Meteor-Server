<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests that run the same scripts and checks on both script engines (MoonSharp and xLua)
       and compare the answers. Needs the Lua library built from native/. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Meteor.Map.Tests</RootNamespace>
    <AssemblyName>Map Server Tests</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="MoonSharp" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Map Server\Map Server.csproj" />
    <ProjectReference Include="..\..\ThirdParty\XLua\XLua.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Data\scripts\**\*" Link="scripts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Lua\**\*.lua" Link="scripts\__tests\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Lua library built for this machine (see native/). -->
    <None Include="..\..\native\runtimes\$(NETCoreSdkRuntimeIdentifier)\native\*xlua.*" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
