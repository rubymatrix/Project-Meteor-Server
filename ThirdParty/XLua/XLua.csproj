<Project Sdk="Microsoft.NET.Sdk">
  <!-- xLua's C# runtime (Tencent/xLua, MIT; see README.md for the commit and local changes), built
       in its non-Unity mode. The native library (libxlua / xlua.dll) comes from native/. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>XLua</RootNamespace>
    <AssemblyName>XLua</AssemblyName>
    <DefineConstants>$(DefineConstants);XLUA_GENERAL</DefineConstants>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <!-- Upstream code: keep its warnings out of the server's build output. -->
    <NoWarn>$(NoWarn);CS0618;CS0162;CS0168;CS0219;CS0414;CS0649;CS8981;CS0108;CS0114</NoWarn>
  </PropertyGroup>
</Project>
